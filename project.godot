; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Tablerama"
config/version="0.2.0"
run/main_scene="res://scenes/BotMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Locale="*res://scripts/i18n/Locale.gd"
ToonStyle="*res://scripts/style/ToonStyle.gd"
Sfx="*res://scripts/audio/Sfx.gd"
Edition="*res://scripts/ui/Edition.gd"
SessionNavigation="*res://scripts/ui/SessionNavigation.gd"
Gamepad="*res://scripts/ui/Gamepad.gd"
PerfMeter="*res://scripts/ui/PerfMeter.gd"
SmokeTest="*res://scripts/ui/SmokeTest.gd"
Net="*res://scripts/net/NetManager.gd"
GameCreatorCore="*res://scripts/game_creator/GameCreatorCore.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="es"

[layer_names]

3d_physics/layer_1="Mesa"
3d_physics/layer_2="Piezas"
3d_physics/layer_3="Bandeja de dados"

[net]

app_id="e70b5d1f-9dc1-4db4-9d9b-18850497e5f4"
region="eu"
user="Jugador"

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="Jolt Physics"
3d/sleep_threshold_linear=0.04
3d/sleep_threshold_angular=0.12

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
