[node name="Title" parent="UI/Panel/Margin/Content" index="1"]
text = "Ajedrez físico"
[node name="Status" parent="UI/Panel/Margin/Content" index="2"]
text = "32 piezas · mesa libre"
[node name="Help" parent="UI/Panel/Margin/Content" index="3"]
text = "Modo manual: mueve las piezas y aplica las reglas. Las piezas colisionan, pueden caerse y se pueden recuperar con H."
[node name="Legend" parent="UI/Panel/Margin/Content" index="4"]
text = "Sin validación de turnos ni movimientos\nP peón · C caballo · A alfil\nT torre · D dama · R rey\nIzquierdo: agarrar / soltar · H: recuperar · L: bloquear · Alt: inspeccionar\nRueda al agarrar: altura\nDerecho: orbitar · rueda: zoom\nCentral / Shift + derecho: pan"
[node name="Reset" parent="UI/Panel/Margin/Content" index="5"]
text = "Reiniciar ajedrez físico"
